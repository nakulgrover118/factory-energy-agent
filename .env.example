# Copy to .env and fill in. .env is git-ignored; never commit a key.
LLM_PROVIDER=bedrock          # mock | bedrock | anthropic
LLM_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
AWS_PROFILE=default           # an AWS profile with Bedrock access to the model
AWS_REGION=us-east-1
# ANTHROPIC_API_KEY=          # only for LLM_PROVIDER=anthropic
# MOCK_LLM=true               # forces template briefs and keyword routing (no LLM)
STORE_DIR=store               # DuckDB data store and SQLite trace
BASELINE_MODEL=ols            # ols | ridge
EMISSION_FACTOR=0.71          # kg CO2e per kWh, used only if the data card has none
CURRENCY=INR                  # used only if the data card has none
SHIFT_HOURS=6,22              # production shift; outside it counts as off-hours
