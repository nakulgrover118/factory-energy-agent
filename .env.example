# Copy to .env and fill in. .env is git-ignored; never commit a key.
LLM_PROVIDER=mock            # mock | anthropic
LLM_MODEL=claude-opus-5-5
MOCK_LLM=true                # true forces template briefs and keyword routing
ANTHROPIC_API_KEY=
STORE_DIR=store              # loaded tables and trace.db
BASELINE_MODEL=ols           # ols | ridge
EMISSION_FACTOR=0.4          # kg CO2e per kWh, used only if the data card has none
